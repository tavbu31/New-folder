QWidget#mainWindow {
    background: #0f172a;
    color: #f8fafc;
    font-family: "Segoe UI";
    font-size: 14px;
}

QPushButton {
    background: #334155;
    color: #f8fafc;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 9px 16px;
    min-height: 20px;
    font-weight: 600;
}

QPushButton:hover {
    background: #475569;
    color: #ffffff;
    border-color: #64748b;
}

QPushButton:pressed {
    background: #1e293b;
    color: #ffffff;
    border-color: #64748b;
}

QPushButton#loadFileButton {
    background: #2563eb;
    color: #ffffff;
    border: 1px solid #1d4ed8;
}

QPushButton#loadFileButton:hover {
    background: #1d4ed8;
    color: #ffffff;
    border-color: #1e40af;
}

QPushButton#loadFileButton:pressed {
    background: #1e40af;
    color: #ffffff;
    border-color: #1e3a8a;
}

QPushButton#aboutButton {
    background: #475569;
    color: #f8fafc;
    border: 1px solid #64748b;
}

QPushButton#aboutButton:hover {
    background: #64748b;
    color: #ffffff;
    border-color: #94a3b8;
}

QPushButton#aboutButton:pressed {
    background: #1e293b;
    color: #ffffff;
    border-color: #475569;
}

QWidget#graphCanvas {
    background: #1e293b;
    color: #f8fafc;
    border: 1px solid #475569;
    border-radius: 8px;
}

QToolBar#graphToolbar {
    background: #1e293b;
    color: #f8fafc;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 4px;
}

QToolBar#graphToolbar QToolButton {
    background: #334155;
    color: #f8fafc;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 4px;
}

QToolBar#graphToolbar QToolButton:hover {
    background: #475569;
    color: #ffffff;
    border-color: #64748b;
}

QToolBar#graphToolbar QToolButton:pressed,
QToolBar#graphToolbar QToolButton:checked {
    background: #1e293b;
    color: #ffffff;
    border-color: #64748b;
}

QWidget#aboutWindow,
QDialog#aboutWindow {
    background: #0f172a;
    color: #f8fafc;
}

QLabel#pictureLabel,
QLabel#nameLabel,
QLabel#roleLabel,
QLabel#emailLabel,
QLabel#linkedinLabel {
    background: #1e293b;
    color: #f8fafc;
}

QLabel#pictureLabel {
    border: 2px solid #3d5a99;
    border-radius: 10px;
}

QLabel#nameLabel {
    color: #f8fafc;
    font-size: 26px;
    font-weight: bold;
}

QLabel#roleLabel,
QLabel#emailLabel,
QLabel#linkedinLabel {
    color: #e2e8f0;
    font-size: 15px;
}
