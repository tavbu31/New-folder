QWidget#mainWindow {
    background: #f4f7fb;
    color: #172033;
    font-family: "Segoe UI";
    font-size: 14px;
}

QLabel#titleLabel {
    color: #172033;
    font-size: 24px;
    font-weight: 700;
    padding-bottom: 2px;
}

QPushButton {
    border-radius: 8px;
    padding: 9px 16px;
    min-height: 20px;
    font-weight: 600;
}

QPushButton#primaryButton {
    background: #4f46e5;
    color: white;
    border: 1px solid #4338ca;
}

QPushButton#primaryButton:hover {
    background: #4338ca;
}

QPushButton#primaryButton:pressed {
    background: #3730a3;
}

QPushButton#secondaryButton {
    background: white;
    color: #334155;
    border: 1px solid #dbe3ef;
}

QPushButton#secondaryButton:hover {
    background: #eef2ff;
    color: #4338ca;
    border-color: #c7d2fe;
}

QPushButton#secondaryButton:pressed {
    background: #e0e7ff;
}

QSpinBox#numberInput {
    background: white;
    color: #172033;
    border: 1px solid #dbe3ef;
    border-radius: 8px;
    padding: 7px 10px;
    min-width: 110px;
}

QSpinBox#numberInput:focus {
    border: 1px solid #ff0000;
}

QSpinBox#numberInput::up-button,
QSpinBox#numberInput::down-button {
    width: 0px;
    border: none;
}

QTableWidget#dataTable {
    background: white;
    color: #172033;
    alternate-background-color: rgb(248, 250, 252);
    border: 1px solid #dbe3ef;
    border-radius: 10px;
    gridline-color: #e8edf4;
    selection-background-color: #e0e7ff;
    selection-color: #172033;
}

QTableWidget#dataTable::item {
    padding: 7px 10px;
    border: none;
}

QTableWidget#dataTable::item:selected {
    background: #e0e7ff;
    color: #172033;
}

QHeaderView::section {
    background: #eef2f7;
    color: #475569;
    border: none;
    border-right: 1px solid #dde5ef;
    border-bottom: 1px solid #dbe3ef;
    padding: 9px 10px;
    font-weight: 700;
}

QTableCornerButton::section {
    background: #eef2f7;
    border: none;
}
